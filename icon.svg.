<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title></title>
</head>
<body>
<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 512 512" width="512" height="512">
  <defs>
    <linearGradient id="bg" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#1b2940"/>
      <stop offset="100%" stop-color="#0b1220"/>
    </linearGradient>
  </defs>
  
  <!-- Фон -->
  <rect width="512" height="512" rx="100" fill="url(#bg)"/>
  
  <!-- Декоративные линии (пресс-форма) -->
  <rect x="80" y="120" width="40" height="272" fill="#293950"/>
  <rect x="392" y="120" width="40" height="272" fill="#293950"/>
  
  <!-- Текст ТПА -->
  <text x="256" y="300" font-family="Arial, sans-serif" font-weight="900" font-size="160" fill="#edf3fc" text-anchor="middle" letter-spacing="5">ТПА</text>
  
  <!-- Зеленая полоса снизу (БАЗА) -->
  <rect x="100" y="340" width="312" height="40" rx="10" fill="#24bd88"/>
  <text x="256" y="370" font-family="Arial, sans-serif" font-weight="bold" font-size="24" fill="#06251c" text-anchor="middle" letter-spacing="8">БАЗА</text>
</svg>
</body>
</html>
